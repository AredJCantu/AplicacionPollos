<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AplicacionPollos.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:AplicacionPollos.Models"
    xmlns:local="clr-namespace:AplicacionPollos"
    xmlns:vm="clr-namespace:AplicacionPollos.ViewModels"
    xmlns:views="clr-namespace:AplicacionPollos.Views"
    Shell.NavBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled"
    Title="AplicacionPollos">
    <Shell.BindingContext>
        <vm:CajasViewModel></vm:CajasViewModel>
    </Shell.BindingContext>
    <ShellContent
ContentTemplate="{DataTemplate views:AgregarCajaView}"
Route="Agregar_Caja"
    ></ShellContent>
    <ShellContent
        ContentTemplate="{DataTemplate views:EditarView}"
        Route="Editar_Caja"
        ></ShellContent>

</Shell>
