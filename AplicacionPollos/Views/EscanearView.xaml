<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AplicacionPollos.Views.EscanearView"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             Title="EscanearView">
    <Grid RowDefinitions="*,auto">
        <zxing:CameraBarcodeReaderView Grid.Row="0"
x:Name="barcodeReader" BarcodesDetected="barcodeReader_BarcodesDetected"
></zxing:CameraBarcodeReaderView>
        <VerticalStackLayout Grid.Row="1">
            <Entry x:Name="txtCodigoEscaneado" FontSize="20"></Entry>
            <Button Text="Escanear" Clicked="Button_Clicked"></Button>
        </VerticalStackLayout>
    </Grid>
</ContentPage>