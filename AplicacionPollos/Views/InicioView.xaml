<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AplicacionPollos.Views.InicioView" 
             Background="#5D5D5D"
             xmlns:vm="clr-namespace:AplicacionPollos.ViewModels"
             x:DataType="vm:CajasViewModel">
    <ContentPage.BindingContext>
        <vm:CajasViewModel></vm:CajasViewModel>
    </ContentPage.BindingContext>
    <VerticalStackLayout>
        <Border Stroke="Black" StrokeThickness="3" BackgroundColor="#736B61">
            <Label Text="Menú de inicio" FontSize="24" HorizontalTextAlignment="Center"></Label>
        </Border>
        <Button Command="{Binding CambiarVistaCommand}" 
                    CommandParameter="{x:Static vm:Vistas.Agregar}" 
                    Text="Escanear cajas" 
                    FontSize="20" 
                    HorizontalOptions="Center"></Button>
        
    </VerticalStackLayout>
</ContentPage>