<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AplicacionPollos.Views.AgregarCajaView"
             Title="Agregue una caja">
    <!--<ContentPage.BindingContext>
        
    </ContentPage.BindingContext>-->
    <Border Stroke="Black" StrokeThickness="5">
        <VerticalStackLayout>
            <Label HorizontalTextAlignment="Center" Text="Agregue una caja:"></Label>
            <Label Text="Código de barras:"></Label>
            <Entry Placeholder="00000000000000000000" Keyboard="Numeric"></Entry>
            <Label Text="Rango de peso:"></Label>
            <Entry Placeholder="3" Keyboard="Numeric"></Entry>
            <Label Text="Peso de la caja:"></Label>
            <Entry Placeholder="00.00"></Entry>
            <Button Text="Enviar" Command="{Binding}"></Button>
        </VerticalStackLayout>
    </Border>
</ContentPage>