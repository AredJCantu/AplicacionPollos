<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AplicacionPollos.Views.AgregarCajaView"
          BackgroundColor="#A0A0A0"
            >
    <ContentPage.Resources>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="#DDDCDC"></Setter>
            <Setter Property="PlaceholderColor" Value="#DDDCDC"></Setter>
            <Setter Property="HeightRequest" Value="45"></Setter>
        </Style>
    </ContentPage.Resources>
    <!--<ContentPage.BindingContext>
        
    </ContentPage.BindingContext>-->
    <VerticalStackLayout>
        <Border Margin="10 10 0 10" Padding="10" Stroke="Black" StrokeThickness="2">
            <VerticalStackLayout>
                <Label FontSize="30" Margin="0 0 10 0" FontAttributes="Bold" HorizontalTextAlignment="Center" Text="Agregue una caja"></Label>
                <Label Text="Código de barras:"></Label>
                <Entry Placeholder="00000000000000000000" Text="{Binding CodigoBarras}" Keyboard="Numeric"></Entry>
                <Label Text="Rango de peso:"></Label>
                <Entry Placeholder="3" Keyboard="Numeric"></Entry>
                <Label Text="Peso de la caja:"></Label>
                <Entry Placeholder="00.00"></Entry>
                <Button HeightRequest="50" BackgroundColor="#4E4E4E" Text="Agregar" Command="{Binding EjemploCommand}"></Button>
            </VerticalStackLayout>
        </Border>
        <CollectionView Margin="10 10 0 10">
            <CollectionView.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="1" Text="ID" FontAttributes="Bold"></Label>
                    <Label Grid.Column="2" Text="No Lote" FontAttributes="Bold"></Label>
                    <Label Grid.Column="3" Text="Rango" FontAttributes="Bold"></Label>
                    <Label Grid.Column="4" Text="Peso" FontAttributes="Bold"></Label>
                </Grid>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="1" Text="1"/>
                        <Label Grid.Column="2" Text="2344"/>
                        <Label Grid.Column="3" Text="3"/>
                        <Label Grid.Column="4" Text="29.87"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>