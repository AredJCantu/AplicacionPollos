<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AplicacionPollos.Views.EditarView"
             xmlns:vm="clr-namespace:AplicacionPollos.ViewModels"
             Title="EditarView">
    <ContentPage.BindingContext>
        <vm:CajasViewModel></vm:CajasViewModel>
    </ContentPage.BindingContext>
    <Border Padding="10"  Stroke="Black" StrokeThickness="2">
        <VerticalStackLayout>
            <Label FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Start" Text="Editar"></Label>
            <Label Text="Código de barras:"></Label>
            <Entry ClearButtonVisibility="WhileEditing" x:Name="txtCodigo" Placeholder="00000000000000000000" Text="{Binding CajaModel.codigo_barras}" Keyboard="Text"></Entry>
            <Label Text="Rango de peso:"></Label>
            <Entry ClearButtonVisibility="WhileEditing" x:Name="txtRango" Placeholder="0" Keyboard="Numeric" Text="{Binding CajaModel.rango_peso}"></Entry>
            <Label Text="Peso de la caja:"></Label>
            <Entry ClearButtonVisibility="WhileEditing" x:Name="txtPeso" Placeholder="00.00" Text="{Binding CajaModel.peso}"></Entry>
            <Button HeightRequest="50" BackgroundColor="OrangeRed" Text="Editar" Command="{Binding EditarCommand}"></Button>
        </VerticalStackLayout>
    </Border>
</ContentPage>